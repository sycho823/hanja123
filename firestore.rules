rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.token.teacher == true; }
    function ownsClass(classId) {
      return isTeacher() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /teachers/{uid} {
      allow read: if self(uid) && isTeacher();
      allow write: if false;
    }
    match /classes/{classId} {
      allow read: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow write: if false;
    }
    match /students/{uid} {
      allow read: if self(uid) || ownsClass(resource.data.classId);
      allow write: if false;
    }
    match /studentProgress/{uid} {
      allow read: if self(uid) || ownsClass(resource.data.classId);
      allow update: if self(uid)
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completed', 'currentChapter', 'updatedAt']);
      allow create, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
